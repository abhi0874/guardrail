          "type": "string"
        }
      },
      "required": [
        "recipient",
        "message"
      ],
      "title": "MockMessage",
      "type": "object"
    },
    "Payload": {
      "additionalProperties": false,
      "properties": {
        "content": {
          "title": "Content",
          "type": "string"
        },
        "user_message": {
          "title": "User Message",
          "type": "string"
        }
      },
      "required": [
        "content",
        "user_message"
      ],
      "title": "Payload",
      "type": "object"
