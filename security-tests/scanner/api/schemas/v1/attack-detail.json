        "rule_outcomes": {
          "additionalProperties": {
            "$ref": "#/$defs/Verdict"
          },
          "title": "Rule Outcomes",
          "type": "object"
        },
        "verdict": {
          "$ref": "#/$defs/Verdict"
        }
      },
      "required": [
        "verdict",
        "findings",
        "evidence_availability",
        "rule_outcomes",
        "judge_outcome",
        "fallback"
      ],
      "title": "Detector",
      "type": "object"
    },
    "DetectorFinding": {
      "additionalProperties": false,
      "properties": {
        "category": {
          "title": "Category",
          "type": "string"
        },
        "detector_version": {
          "const": "rules-1.0",
          "title": "Detector Version",
          "type": "string"
        },
        "evidence": {
          "items": {
            "type": "string"
          },
          "title": "Evidence",
          "type": "array"
        },
        "explanation": {
          "title": "Explanation",
          "type": "string"
        },
        "rule_id": {
          "title": "Rule Id",
          "type": "string"
        },
        "verdict": {
          "$ref": "#/$defs/Verdict"
        }
