{
  "$defs": {
    "Counts": {
      "additionalProperties": false,
      "properties": {
        "blocked_or_not_observed": {
          "minimum": 0,
          "title": "Blocked Or Not Observed",
          "type": "integer"
        },
        "completed": {
          "minimum": 0,
          "title": "Completed",
          "type": "integer"
        },
        "distinct_findings": {
          "minimum": 0,
          "title": "Distinct Findings",
          "type": "integer"
        },
        "failed": {
          "minimum": 0,
          "title": "Failed",
          "type": "integer"
        },
        "indeterminate": {
          "minimum": 0,
          "title": "Indeterminate",
          "type": "integer"
        },
        "loaded": {
          "minimum": 0,
          "title": "Loaded",
          "type": "integer"
        },
        "observed_effects": {
          "minimum": 0,
          "title": "Observed Effects",
          "type": "integer"
        },
        "prepared": {
          "minimum": 0,
          "title": "Prepared",
          "type": "integer"
        },
        "recorded_executions": {
          "minimum": 0,
          "title": "Recorded Executions",
          "type": "integer"
        },
        "severity_distribution": {
          "additionalProperties": {
            "minimum": 0,
            "type": "integer"
          },
          "propertyNames": {
            "enum": [
              "Critical",
              "High",
              "Medium",
              "Low",
              "Informational"
            ]
          },
          "title": "Severity Distribution",
          "type": "object"
        },
        "skipped": {
          "minimum": 0,
          "title": "Skipped",
          "type": "integer"
        },
        "submitted": {
          "minimum": 0,
          "title": "Submitted",
          "type": "integer"
        },
        "successful_attack_executions": {
          "minimum": 0,
          "title": "Successful Attack Executions",
          "type": "integer"
        },
        "timed_out": {
          "minimum": 0,
          "title": "Timed Out",
          "type": "integer"
        },
        "trace_events": {
          "minimum": 0,
          "title": "Trace Events",
          "type": "integer"
        },
        "unevaluated": {
          "minimum": 0,
          "title": "Unevaluated",
          "type": "integer"
        }
      },
      "required": [
        "loaded",
        "prepared",
        "submitted",
        "recorded_executions",
        "completed",
        "failed",
        "timed_out",
        "skipped",
        "trace_events",
        "successful_attack_executions",
        "observed_effects",
        "distinct_findings",
        "blocked_or_not_observed",
        "indeterminate",
        "unevaluated",
        "severity_distribution"
      ],
      "title": "Counts",
      "type": "object"
    }
  },
  "$id": "urn:agent-security-scanner:api:v1:overview",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "counts": {
      "$ref": "#/$defs/Counts"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "title": "Limitations",
      "type": "array"
    },
    "scan_ids": {
      "items": {
        "maxLength": 128,
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
        "type": "string"
      },
      "title": "Scan Ids",
      "type": "array"
    },
    "schema_version": {
      "const": "api-1.0",
      "default": "api-1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "scope": {
      "const": "local_synthetic_sandbox",
      "default": "local_synthetic_sandbox",
      "title": "Scope",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "scope",
    "counts",
    "scan_ids",
    "limitations"
  ],
  "title": "Overview",
  "type": "object"
}
