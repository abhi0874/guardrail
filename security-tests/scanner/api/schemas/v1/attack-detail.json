      "required": [
        "role",
        "allowed_tools",
        "allowed_documents",
        "allowed_recipients",
        "allowed_arguments",
        "canaries",
        "user_supplied_values",
        "authorized_disclosures"
      ],
      "title": "Authorization",
      "type": "object"
    },
    "CallEvent": {
      "additionalProperties": false,
      "properties": {
        "event_type": {
