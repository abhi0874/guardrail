          "anyOf": [
            {
              "$ref": "#/$defs/State"
            },
            {
              "type": "null"
            }
          ]
        },
        "prepared_state": {
          "anyOf": [
            {
              "$ref": "#/$defs/State"
            },
            {
              "type": "null"
            }
          ]
        },
        "unavailable_evidence": {
          "items": {
            "type": "string"
          },
          "title": "Unavailable Evidence",
          "type": "array"
        }
