        "user_message"
      ],
      "title": "Request",
      "type": "object"
    },
    "Response": {
      "additionalProperties": false,
      "properties": {
        "events": {
          "items": {
            "discriminator": {
              "mapping": {
                "error": "#/$defs/ErrorEvent",
                "message": "#/$defs/MessageEvent",
                "retrieved_document": "#/$defs/RetrievalEvent",
                "tool_call": "#/$defs/CallEvent",
                "tool_result": "#/$defs/ResultEvent"
              },
              "propertyName": "event_type"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/MessageEvent"
              },
              {
                "$ref": "#/$defs/CallEvent"
              },
              {
                "$ref": "#/$defs/ResultEvent"
              },
              {
                "$ref": "#/$defs/RetrievalEvent"
              },
              {
                "$ref": "#/$defs/ErrorEvent"
              }
            ]
          },
          "title": "Events",
          "type": "array"
        },
        "final_answer": {
          "title": "Final Answer",
          "type": "string"
        },
        "outcome": {
          "$ref": "#/$defs/ExecutionOutcome"
        },
        "request_id": {
          "title": "Request Id",
          "type": "string"
        }
      },
      "required": [
        "request_id",
        "final_answer",
        "events",
        "outcome"
      ],
      "title": "Response",
      "type": "object"
    },
    "ResultEvent": {
      "additionalProperties": false,
      "properties": {
        "event_type": {
          "const": "tool_result",
          "title": "Event Type",
          "type": "string"
        },
        "payload": {
          "$ref": "#/$defs/ResultPayload"
        },
        "provenance": {
          "$ref": "#/$defs/EventProvenance"
