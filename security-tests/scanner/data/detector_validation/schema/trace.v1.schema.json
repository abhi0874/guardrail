{
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "family": {
      "type": "string",
      "minLength": 1
    },
    "category": {
      "enum": [
        "direct",
        "indirect",
        "poisoned_documents",
        "unauthorized_calls",
        "argument_tampering",
        "exfiltration",
        "privilege_escalation"
      ]
    },
    "label": {
      "enum": [
        "SUCCESS",
        "BLOCKED_OR_NOT_OBSERVED",
        "INDETERMINATE"
      ]
    },
    "justification": {
      "type": "string",
      "minLength": 1
    },
    "provenance": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "constructed",
            "sandbox-observed"
          ]
        },
        "assumption": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "kind",
        "assumption"
      ],
      "additionalProperties": false
    },
    "input": {
      "type": "object",
      "properties": {
        "response": {
          "type": "object",
          "properties": {
            "request_id": {
              "type": "string",
              "minLength": 1
            },
            "final_answer": {
              "type": "string"
            },
            "events": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "event_type": {
                    "enum": [
                      "message",
                      "retrieved_document",
                      "tool_call",
                      "tool_result",
                      "error"
                    ]
                  },
                  "sequence": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "payload": {
                    "type": "object"
                  },
                  "provenance": {
                    "type": "object"
                  }
                },
                "required": [
                  "event_type",
                  "sequence",
                  "payload",
                  "provenance"
                ],
                "additionalProperties": false
              }
            },
            "outcome": {
              "enum": [
                "success",
                "error",
                "timeout",
                "rejected"
              ]
            }
          },
          "required": [
            "request_id",
            "final_answer",
            "events",
            "outcome"
          ],
          "additionalProperties": false
        },
        "condition": {
          "type": "object",
          "properties": {
            "evidence": {
              "type": "string",
              "enum": [
                "final_answer",
                "tool_call",
                "tool_result",
                "document_state",
                "outbox"
              ]
            },
            "prohibited_action": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000,
              "pattern": "\\S"
            },
            "marker": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000,
              "pattern": "\\S"
            },
            "tool": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "name": {
                      "const": "search_documents"
                    },
                    "arguments": {
                      "type": "object",
                      "properties": {
                        "query": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 10000,
                          "pattern": "\\S"
                        }
                      },
                      "required": [
                        "query"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "required": [
                    "name",
                    "arguments"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "name": {
                      "const": "read_document"
                    },
                    "arguments": {
                      "type": "object",
                      "properties": {
                        "document_id": {
                          "type": "string",
                          "enum": [
                            "public",
                            "policy",
                            "restricted"
                          ]
                        }
                      },
                      "required": [
                        "document_id"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "required": [
                    "name",
                    "arguments"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "name": {
                      "const": "send_message"
                    },
                    "arguments": {
                      "type": "object",
                      "properties": {
                        "recipient": {
                          "type": "string",
                          "enum": [
                            "synthetic-inbox"
                          ]
                        },
                        "message": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 10000,
                          "pattern": "\\S"
                        }
                      },
                      "required": [
                        "recipient",
                        "message"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "required": [
                    "name",
                    "arguments"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "name": {
                      "const": "update_document"
                    },
                    "arguments": {
                      "type": "object",
                      "properties": {
                        "document_id": {
                          "type": "string",
                          "enum": [
                            "public",
                            "policy",
                            "restricted"
                          ]
                        },
                        "content": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 10000,
                          "pattern": "\\S"
                        }
                      },
                      "required": [
                        "document_id",
                        "content"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "required": [
                    "name",
                    "arguments"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "name": {
                      "const": "change_access_level"
                    },
                    "arguments": {
                      "type": "object",
                      "properties": {
                        "document_id": {
                          "type": "string",
                          "enum": [
                            "public",
                            "policy",
                            "restricted"
                          ]
                        },
                        "access": {
                          "type": "string",
                          "enum": [
                            "public",
                            "internal",
                            "restricted"
                          ]
                        }
                      },
                      "required": [
                        "document_id",
                        "access"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "required": [
                    "name",
                    "arguments"
                  ],
                  "additionalProperties": false
                }
              ]
            }
          },
          "required": [
            "evidence",
            "prohibited_action",
            "marker",
            "tool"
          ],
          "additionalProperties": false
        },
        "authorization": {
          "type": "object",
          "properties": {
            "role": {
              "enum": [
                "reader",
                "staff",
                "admin"
              ]
            },
            "allowed_tools": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "allowed_documents": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "allowed_recipients": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "allowed_arguments": {
              "type": "object",
              "additionalProperties": {
                "type": "string",
                "minLength": 1
              }
            },
            "canaries": {
              "type": "object",
              "additionalProperties": {
                "type": "string",
                "minLength": 1
              }
            },
            "user_supplied_values": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "authorized_disclosures": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "required": [
            "role",
            "allowed_tools",
            "allowed_documents",
            "allowed_recipients",
            "allowed_arguments",
            "canaries",
            "user_supplied_values",
            "authorized_disclosures"
          ],
          "additionalProperties": false
        },
        "complete_trace": {
          "type": "boolean"
        },
        "available_evidence": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "response",
        "condition",
        "authorization",
        "complete_trace",
        "available_evidence"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "id",
    "family",
    "category",
    "label",
    "justification",
    "provenance",
    "input"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
