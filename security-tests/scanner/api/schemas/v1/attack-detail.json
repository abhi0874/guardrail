          "type": "string"
        },
        "execution_support": {
          "enum": [
            "native_user_message",
            "requires_document_preparation"
          ],
          "title": "Execution Support",
          "type": "string"
        },
        "role": {
          "enum": [
            "reader",
            "staff",
            "admin"
          ],
          "title": "Role",
          "type": "string"
        }
      },
      "required": [
        "role",
        "document_id",
        "execution_support"
      ],
      "title": "Setup",
      "type": "object"
    },
    "State": {
      "additionalProperties": false,
      "properties": {
        "documents": {
          "patternProperties": {
            "^[a-z0-9]+(?:-[a-z0-9]+)*$": {
