{
  "name": "guardrail-console",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "oxlint --deny-warnings --react-plugin --nextjs-plugin --jsx-a11y-plugin app components lib tests playwright.config.ts",
    "test": "playwright test",
    "start": "next start",
    "lab": "FRONTEND_ORIGIN=http://127.0.0.1:3000 RECRUITER_LOCAL_LAB=1 next dev --hostname 127.0.0.1 --port 3000"
  },
  "dependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "lucide-react": "1.73.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "recharts": "3.10.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.1",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "oxlint": "1.93.0",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": "26.x"
  }
}
