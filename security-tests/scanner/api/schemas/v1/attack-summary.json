{
  "$defs": {
    "Status": {
      "enum": [
        "COMPLETED",
        "FAILED",
        "TIMED_OUT",
        "SKIPPED"
      ],
      "title": "Status",
      "type": "string"
    },
    "Verdict": {
      "enum": [
        "SUCCESS",
        "BLOCKED_OR_NOT_OBSERVED",
        "INDETERMINATE"
      ],
      "title": "Verdict",
      "type": "string"
    }
  },
  "$id": "urn:agent-security-scanner:api:v1:attack-summary",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "attack_id": {
      "maxLength": 128,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "title": "Attack Id",
      "type": "string"
    },
    "category": {
      "enum": [
        "direct",
        "indirect",
        "poisoned_documents",
        "unauthorized_calls",
        "argument_tampering",
        "exfiltration",
        "privilege_escalation"
      ],
      "title": "Category",
      "type": "string"
    },
    "detector_verdict": {
      "anyOf": [
        {
          "$ref": "#/$defs/Verdict"
        },
        {
          "type": "null"
        }
      ]
    },
    "duration": {
      "minimum": 0,
      "title": "Duration",
      "type": "number"
    },
    "entry_point": {
      "enum": [
        "user_message",
        "retrieved_document"
      ],
      "title": "Entry Point",
      "type": "string"
    },
    "event_count": {
      "minimum": 0,
      "title": "Event Count",
      "type": "integer"
    },
    "finding_ids": {
      "items": {
        "maxLength": 128,
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
        "type": "string"
      },
      "title": "Finding Ids",
      "type": "array"
    },
    "prepared": {
      "title": "Prepared",
      "type": "boolean"
    },
    "revision": {
      "minimum": 1,
      "title": "Revision",
      "type": "integer"
    },
    "scan_id": {
      "maxLength": 128,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "title": "Scan Id",
      "type": "string"
    },
    "schema_version": {
      "const": "api-1.0",
      "default": "api-1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/Status"
    },
    "submitted": {
      "title": "Submitted",
      "type": "boolean"
    },
    "title": {
      "title": "Title",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "scan_id",
    "attack_id",
    "revision",
    "title",
    "category",
    "entry_point",
    "status",
    "prepared",
    "submitted",
    "detector_verdict",
    "duration",
    "event_count",
    "finding_ids"
  ],
  "title": "AttackSummary",
  "type": "object"
}
