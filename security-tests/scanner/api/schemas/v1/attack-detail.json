            {
              "items": {
                "maxLength": 128,
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
                "type": "string"
              },
              "type": "array"
            }
          ],
          "title": "Result"
        }
      },
      "required": [
        "call_id",
        "result"
      ],
      "title": "ResultPayload",
      "type": "object"
    },
    "RetrievalEvent": {
      "additionalProperties": false,
      "properties": {
        "event_type": {
          "const": "retrieved_document",
          "title": "Event Type",
          "type": "string"
        },
        "payload": {
          "$ref": "#/$defs/Document"
        },
        "provenance": {
          "$ref": "#/$defs/EventProvenance"
        },
        "sequence": {
          "minimum": 0,
          "title": "Sequence",
          "type": "integer"
        }
      },
      "required": [
        "sequence",
        "provenance",
        "event_type",
        "payload"
      ],
      "title": "RetrievalEvent",
