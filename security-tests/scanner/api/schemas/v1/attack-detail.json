          "title": "Evidence",
          "type": "string"
        },
        "marker": {
          "title": "Marker",
          "type": "string"
        },
        "prohibited_action": {
          "title": "Prohibited Action",
          "type": "string"
        },
        "tool": {
          "$ref": "#/$defs/ToolCall"
        }
      },
      "required": [
        "evidence",
        "marker",
