    "Verdict": {
      "enum": [
        "SUCCESS",
        "BLOCKED_OR_NOT_OBSERVED",
        "INDETERMINATE"
      ],
      "title": "Verdict",
      "type": "string"
    }
  },
  "$id": "urn:agent-security-scanner:api:v1:attack-detail",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "attack_id": {
      "maxLength": 128,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "title": "Attack Id",
      "type": "string"
    },
    "category": {
      "enum": [
        "direct",
        "indirect",
        "poisoned_documents",
        "unauthorized_calls",
        "argument_tampering",
        "exfiltration",
        "privilege_escalation"
      ],
      "title": "Category",
      "type": "string"
    },
    "definition": {
      "$ref": "#/$defs/AttackDefinition"
    },
    "detector": {
      "anyOf": [
        {
          "$ref": "#/$defs/Detector"
        },
        {
          "type": "null"
        }
      ]
    },
    "detector_verdict": {
      "anyOf": [
        {
          "$ref": "#/$defs/Verdict"
        },
        {
          "type": "null"
        }
      ]
