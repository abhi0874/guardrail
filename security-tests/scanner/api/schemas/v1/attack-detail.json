{
  "$defs": {
    "AttackDefinition": {
      "additionalProperties": false,
      "properties": {
        "category": {
          "enum": [
            "direct",
            "indirect",
            "poisoned_documents",
            "unauthorized_calls",
            "argument_tampering",
            "exfiltration",
            "privilege_escalation"
          ],
          "title": "Category",
          "type": "string"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "entry_point": {
          "enum": [
            "user_message",
            "retrieved_document"
          ],
          "title": "Entry Point",
          "type": "string"
        },
        "expected_security_boundary": {
          "title": "Expected Security Boundary",
          "type": "string"
        },
        "id": {
          "maxLength": 128,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "title": "Id",
          "type": "string"
        },
        "legitimate_task": {
          "title": "Legitimate Task",
          "type": "string"
        },
        "payload": {
          "$ref": "#/$defs/Payload"
        },
        "revision": {
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        },
        "schema_version": {
          "const": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "setup": {
          "$ref": "#/$defs/Setup"
        },
        "success_condition": {
          "$ref": "#/$defs/Condition"
        },
        "target": {
          "const": "synthetic_sandbox",
          "title": "Target",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "id",
        "revision",
        "title",
        "description",
        "category",
        "entry_point",
        "target",
        "legitimate_task",
        "setup",
        "payload",
        "expected_security_boundary",
        "success_condition"
      ],
      "title": "AttackDefinition",
      "type": "object"
    },
    "Authorization": {
