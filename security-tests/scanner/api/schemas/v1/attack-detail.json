          ],
          "title": "Access",
          "type": "string"
        },
        "content": {
          "title": "Content",
          "type": "string"
        },
        "document_id": {
          "maxLength": 128,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "title": "Document Id",
          "type": "string"
        }
      },
      "required": [
        "document_id",
        "content",
        "access"
      ],
      "title": "DocumentResult",
      "type": "object"
    },
    "ErrorEvent": {
      "additionalProperties": false,
      "properties": {
        "event_type": {
          "const": "error",
          "title": "Event Type",
          "type": "string"
        },
        "payload": {
          "$ref": "#/$defs/ErrorPayload"
        },
        "provenance": {
          "$ref": "#/$defs/EventProvenance"
        },
        "sequence": {
          "minimum": 0,
