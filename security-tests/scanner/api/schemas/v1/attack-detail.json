        },
        "call_id": {
          "maxLength": 128,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "title": "Call Id",
          "type": "string"
        },
        "name": {
          "enum": [
            "search_documents",
            "read_document",
            "send_message",
            "update_document",
            "change_access_level"
          ],
