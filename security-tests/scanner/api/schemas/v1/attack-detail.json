          },
          "title": "Allowed Tools",
          "type": "array"
        },
        "authorized_disclosures": {
          "items": {
            "type": "string"
          },
          "title": "Authorized Disclosures",
          "type": "array"
        },
        "canaries": {
          "additionalProperties": {
            "maxLength": 128,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "type": "string"
          },
          "title": "Canaries",
          "type": "object"
        },
        "role": {
          "enum": [
            "reader",
            "staff",
            "admin"
          ],
          "title": "Role",
          "type": "string"
        },
        "user_supplied_values": {
          "items": {
            "type": "string"
          },
          "title": "User Supplied Values",
          "type": "array"
        }
