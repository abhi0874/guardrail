MCP_AGENT_NAME=mcp-agent-server
MCP_AGENT_ENVIRONMENT=local
MCP_AGENT_LOG_LEVEL=INFO
MCP_AGENT_TRANSPORT=stdio

MCP_AGENT_AUDIT_DB=.runtime/audit/events.sqlite3
MCP_AGENT_MAX_ARGUMENT_BYTES=8192
MCP_AGENT_MAX_ARGUMENT_DEPTH=8
MCP_AGENT_POLICY=policies/tool_access.yaml

# Cloud: inject secrets privately; do not put real values in this tracked template.
# MCP_AGENT_ENVIRONMENT=production
# MCP_AGENT_STORAGE_BACKEND=postgresql
# MCP_AGENT_DATABASE_URL=<private runtime role URI with sslmode=verify-full, session port 5432>
# MCP_CLOUD_HOSTS=<exact API hostname>
# MCP_CLOUD_ORIGINS=<exact HTTPS website origin>
# MCP_CLOUD_TRUSTED_PROXIES=<verified immediate edge CIDRs; no wildcard>
# MCP_CLOUD_CLIENTS=<private JSON array of identifier UUID and random 32-byte token>
# PORT=10000
# Separate operator-only migration job; never inject this credential into the web service.
# MCP_AGENT_MIGRATION_URL=<private owner URI>
# MCP_AGENT_MIGRATION_LOCK_SECONDS=2
# MCP_AGENT_MIGRATION_STATEMENT_SECONDS=5
