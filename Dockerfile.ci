FROM ghcr.io/astral-sh/uv:0.13.10@sha256:a3ea1357342c1a4bf9a0c53a3deb1b55379aefa037338d8113d5771efa01774f AS uv
FROM python:3.11.15-slim-bookworm@sha256:d29f48a31a8b408ed19272ca1e7b10ebae13b240a27e862d3d4217c528e2e0c3
COPY --from=uv /uv /usr/local/bin/uv
ENV UV_LINK_MODE=copy UV_PYTHON_DOWNLOADS=never PYTHONDONTWRITEBYTECODE=1 UV_CACHE_DIR=/app/.cache/uv
WORKDIR /app
COPY . .
RUN uv sync --frozen --python /usr/local/bin/python \
    && groupadd --gid 10001 app && useradd --uid 10001 --gid app --create-home app \
    && mkdir -p .runtime/audit .cache/reports \
    && chown -R app:app /app
ENV PATH="/app/.venv/bin:$PATH" UV_OFFLINE=1 UV_NO_SYNC=1
USER 10001:10001
CMD ["bash", "scripts/ci-checks.sh"]
