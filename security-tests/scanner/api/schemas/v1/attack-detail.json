          "items": {
            "$ref": "#/$defs/MockMessage"
          },
          "title": "Outbox",
          "type": "array"
        },
        "role": {
          "enum": [
            "reader",
            "staff",
            "admin"
          ],
          "title": "Role",
          "type": "string"
        }
